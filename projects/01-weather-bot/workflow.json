    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, type\nFROM ru_locations\nWHERE parent_id = CAST('{{ $('Telegram Trigger1').item.json.callback_query.data.split('_')[1] }}' AS INTEGER)\nORDER BY \n    CASE type \n        WHEN 'district' THEN 1 \n        WHEN 'city' THEN 2 \n        WHEN 'city_district' THEN 3\n        ELSE 4 \n    END,\n    name\nLIMIT 6 OFFSET (CAST('{{ $('Telegram Trigger1').item.json.callback_query.data.split('_')[2] }}' AS INTEGER) - 1) * 5;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        4528,
        2928
