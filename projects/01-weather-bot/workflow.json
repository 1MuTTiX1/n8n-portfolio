        "operation": "executeQuery",
        "query": "SELECT \n    id, \n    CASE name\n        WHEN 'Москва' THEN 'Москва'\n        WHEN 'Санкт-Петербург' THEN 'Санкт-Петербург'\n        WHEN 'Краснодарский' THEN 'Краснодар'\n        WHEN 'Саратовская' THEN 'Саратов'\n        WHEN 'Новосибирская' THEN 'Новосибирск'\n        ELSE name\n    END AS name\nFROM ru_locations\nWHERE type = 'region' \n  AND name IN ('Москва', 'Санкт-Петербург', 'Краснодарский', 'Саратовская', 'Новосибирская')\nORDER BY CASE name \n    WHEN 'Москва' THEN 1 \n    WHEN 'Санкт-Петербург' THEN 2 \n    WHEN 'Краснодарский' THEN 3 \n    WHEN 'Саратовская' THEN 4 \n    WHEN 'Новосибирская' THEN 5 \n    ELSE 6 \nEND;",
        "options": {}
