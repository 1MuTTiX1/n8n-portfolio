    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst hasNext = items.length > 5;\nconst locations = hasNext ? items.slice(0, 5) : items;\n\nconst inlineKeyboard = [];\nlet currentRow = [];\n\nfor (let i = 0; i < locations.length; i++) {\n    const loc = locations[i].json;\n    \n    // Добавляем иконку: 🏙 для районов, 📍 для городов\n    const icon = loc.type === 'district' ? '🏙 ' : '📍 ';\n    \n    currentRow.push({\n        text: `${icon}${loc.name}`,\n        callback_data: `loc_${loc.id}_${loc.type}` \n    });\n    \n    if (currentRow.length === 2) {\n        inlineKeyboard.push(currentRow);\n        currentRow = [];\n    }\n}\nif (currentRow.length > 0) inlineKeyboard.push(currentRow);\n\n// Пагинация (кнопка Дальше)\nconst currentData = $('Telegram Trigger1').item.json.callback_query.data;\nconst parts = currentData.split('_');\nconst regionId = parts[1];\nconst page = parseInt(parts[2]);\n\nif (hasNext) {\n    // Добавляем только ОДНУ кнопку Дальше\n    inlineKeyboard.push([{ text: \"➡️ Дальше\", callback_data: `districts_${regionId}_${page + 1}` }]);\n}\n\ninlineKeyboard.push([{ text: \"⬅️ Назад к регионам\", callback_data: \"add_city\" }]);\n\nreturn [{\n    json: {\n        chat_id: $('Telegram Trigger1').item.json.callback_query.message.chat.id,\n        text: \"📍 Выберите район или город:\",\n        reply_markup: { inline_keyboard: inlineKeyboard }\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
