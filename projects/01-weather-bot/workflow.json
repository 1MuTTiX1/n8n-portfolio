    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst inlineKeyboard = []; // Создаем массив для строк\nlet currentRow = [];\n\nfor (let i = 0; i < items.length; i++) {\n    const region = items[i].json;\n    \n    // Создаем ПЛОСКУЮ кнопку, как в вашем идеальном JSON\n    currentRow.push({\n        text: region.name,\n        callback_data: `districts_${region.id}_1`\n    });\n\n    if (currentRow.length === 2) {\n        inlineKeyboard.push(currentRow);\n        currentRow = [];\n    }\n}\n\nif (currentRow.length > 0) {\n    inlineKeyboard.push(currentRow);\n}\n\n// Кнопки ввода и назад\ninlineKeyboard.push([{ text: \"✏️ Ввести свой город\", callback_data: \"type_custom_city\" }]);\ninlineKeyboard.push([{ text: \"⬅️ Назад в меню\", callback_data: \"back_to_menu\" }]);\n\nreturn [{\n    json: {\n        chat_id: $('Telegram Trigger1').item.json.callback_query.message.chat.id,\n        text: \"🌍 Выберите город из списка или введите свой:\",\n        // Формируем объект ТОЧНО как в вашем скриншоте\n        reply_markup: { \n            inline_keyboard: inlineKeyboard \n        }\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4672,
        2256
      ],
      "id": "c5a3f3c2-2630-497d-b74f-ed44bdfe018d",
